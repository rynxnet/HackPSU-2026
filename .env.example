# ==============================================================================
# ResearchIDE Environment Configuration
# ==============================================================================

# Gemini LLM & Embeddings API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=researchide
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/researchide
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/researchide

# S3 / MinIO Object Storage Configuration
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=researchide
S3_REGION=us-east-1

# GROBID Academic Paper Parser
GROBID_URL=http://localhost:8070
GROBID_TIMEOUT_SECONDS=60

# Authentication & Security
SECRET_KEY=super-secret-jwt-and-session-encryption-key-change-in-production-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
SESSION_COOKIE_NAME=researchide_session

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_S3_URL=http://localhost:9000/researchide
